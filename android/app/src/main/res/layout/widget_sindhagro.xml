<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_widget_bg"
    android:orientation="vertical"
    android:padding="10dp"
    android:layoutDirection="rtl">

    <!-- 1. Header Bar: App Label, Selected District, Refresh Button -->
    <LinearLayout
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/widget_app_label" />

        <TextView
            android:id="@+id/widget_app_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_app_label"
            android:textColor="@color/white"
            android:textSize="12.5sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />

        <TextView
            android:id="@+id/widget_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_default_district"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:background="@color/white_glass"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:layout_marginStart="6dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <!-- RemoteViews-safe spacer -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_action_refresh"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@color/white_glass"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- Subtle Divider -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white_glass"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="4dp" />

    <!-- 2. Main Body: Sindhi agricultural month/season & rotating agro proverb/tip -->
    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/widget_calendar_season"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/widget_default_season"
                android:textColor="@color/mint_accent"
                android:textSize="11sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/widget_tip_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌾 ڏاهپ"
                android:textColor="@color/white_semi"
                android:textSize="9.5sp"
                android:background="@color/white_glass"
                android:paddingHorizontal="5dp"
                android:paddingVertical="1.5dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_tip_saying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_default_saying"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginTop="2.5dp"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_tip_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/widget_default_explanation"
            android:textColor="@color/white_semi"
            android:textSize="10sp"
            android:layout_marginTop="1dp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- 3. Footer Strip: Saved Field Summary & Open Action -->
    <LinearLayout
        android:id="@+id/widget_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/white_glass"
        android:paddingHorizontal="8dp"
        android:paddingVertical="4dp"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_field_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_default_field_status"
            android:textColor="@color/mint_subtle"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/widget_btn_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_action_open"
            android:textColor="@color/forest_green"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:background="@color/white"
            android:paddingHorizontal="9dp"
            android:paddingVertical="3dp"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
