<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ic_widget_bg"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="10dp"
    android:layoutDirection="rtl">

    <!-- ══ هيڊر: ايپ جو نالو ۽ مهينو ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/widget_app_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="6dp" />

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:background="@color/white_glass"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <!-- ══ مهينو ۽ موسم ══ -->
    <TextView
        android:id="@+id/widget_month_season"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_default_season"
        android:textColor="@color/mint_accent"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textAlignment="center"
        android:layout_marginTop="5dp" />

    <!-- ══ لاٽي پاٽي / آهرو ══ -->
    <TextView
        android:id="@+id/widget_tip_saying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_default_saying"
        android:textColor="@color/white"
        android:textSize="12.5sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textAlignment="center"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- ══ وضاحت ══ -->
    <TextView
        android:id="@+id/widget_tip_explanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_default_explanation"
        android:textColor="@color/white_semi"
        android:textSize="10sp"
        android:gravity="center"
        android:textAlignment="center"
        android:layout_marginTop="2dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- ══ پوک سلاح ══ -->
    <TextView
        android:id="@+id/widget_plant_advice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/widget_default_plant_advice"
        android:textColor="@color/mint_accent"
        android:textSize="10sp"
        android:gravity="center"
        android:textAlignment="center"
        android:layout_marginTop="4dp"
        android:maxLines="2"
        android:ellipsize="end" />

    <!-- ══ ايپ کولڻ جو بٽڻ ══ -->
    <TextView
        android:id="@+id/widget_btn_open"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_action_open"
        android:textColor="@color/forest_green"
        android:textSize="10.5sp"
        android:textStyle="bold"
        android:gravity="center"
        android:textAlignment="center"
        android:layout_gravity="center"
        android:background="@color/white"
        android:paddingHorizontal="12dp"
        android:paddingVertical="3dp"
        android:layout_marginTop="5dp"
        android:clickable="true"
        android:focusable="true" />

</LinearLayout>
